# Required. Use a Resend API key with permission to retrieve received emails.
RESEND_API_KEY=re_replace_me
# Resend > Webhooks > your endpoint > Signing Secret
RESEND_WEBHOOK_SECRET=whsec_replace_me

# Optional: only process email whose To recipients include this exact mailbox.
# Case-insensitive; leave empty to process all recipients.
INBOUND_EMAIL_TO=

# Set both to enable automatic ticket creation, including saved pending drafts.
# Instance root URL; omit /rest. Leave both empty for inbox-only operation.
TWENTY_BASE_URL=
TWENTY_API_KEY=

# Defaults for native execution; Compose sets these inside the container.
PORT=8080
DATA_DIR=./data
