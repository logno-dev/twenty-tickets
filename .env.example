# Required. Use a Resend API key with permission to retrieve received emails.
RESEND_API_KEY=re_replace_me
# Received-email retrieval deadline. Must be positive and no greater than 45s.
RESEND_HTTP_TIMEOUT=30s
# Resend > Webhooks > your endpoint > Signing Secret
RESEND_WEBHOOK_SECRET=whsec_replace_me

# Required for /admin/. Configure Twenty connections and inbound routes there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Defaults for native execution; Compose sets these inside the container.
PORT=8080
DATA_DIR=./data
